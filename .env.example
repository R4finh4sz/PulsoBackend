DB_URL=jdbc:postgresql://localhost:5432/teste.
DB_USERNAME=
DB_PASSWORD=

# MailerSend SMTP: app.mailersend.com > Domains > seu dominio > SMTP settings
# Use o usuario e a senha SMTP gerados no painel (nao a senha da conta ou API token).
# MAILERSEND_FROM_EMAIL deve pertencer ao dominio verificado no MailerSend.
MAILERSEND_SMTP_HOST=smtp.mailersend.net
MAILERSEND_SMTP_PORT=587
MAILERSEND_SMTP_USERNAME=
MAILERSEND_SMTP_PASSWORD=
MAILERSEND_FROM_EMAIL=
# Base64 of at least 32 random bytes; keep private and stable across instances.
JWT_SECRET=
JWT_SESSION_TTL=30m
