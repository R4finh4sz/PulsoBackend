DB_URL=jdbc:postgresql://localhost:5432/teste.
DB_USERNAME=
DB_PASSWORD=
# Em producao, use um usuario diferente para migracoes (proprietario das tabelas).
# A conta DB_USERNAME deve ser de execucao, sem superusuario, propriedade de tabelas ou permissoes DDL.
# DB_MIGRATION_USERNAME=
# DB_MIGRATION_PASSWORD=

# Resend: https://resend.com/api-keys
# O remetente deve pertencer a um dominio verificado no Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Base64 of at least 32 random bytes; keep private and stable across instances.
JWT_SECRET=
# Validade do JWT de acesso (1m a 24h).
JWT_SESSION_TTL=50m
# Duracao da unica renovacao permitida (1m a 24h).
JWT_REFRESH_TTL=10m
# Limites por usuario (autenticado) ou dispositivo (publico), por instancia.
# Duracoes aceitam 30s, 1m, 1h.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m

# Obrigatorios em toda inicializacao; cria o admin se ainda nao existir.
BOOTSTRAP_ADMIN_EMAIL=
# Minimo de 8 caracteres, uma maiuscula, um numero e maximo de 72 bytes UTF-8.
BOOTSTRAP_ADMIN_PASSWORD=
